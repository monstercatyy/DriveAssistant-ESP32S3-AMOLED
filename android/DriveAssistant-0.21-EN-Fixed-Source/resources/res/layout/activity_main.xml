<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_weight="1"/>
            <Button
                android:textSize="24sp"
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="⋮"
                android:contentDescription="@string/menu_more"
                style="?attr/borderlessButtonStyle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:id="@+id/dotStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:paddingEnd="8dp"/>
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step1"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvNotifStatus"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notif_missing"
            android:paddingStart="26dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notif_privacy_hint"
            android:paddingStart="26dp"/>
        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_notif_access"/>
        <TextView
            android:textColor="#ffc62828"
            android:id="@+id/tvRestricted"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restricted_hint"
            android:paddingStart="26dp"/>
        <Button
            android:id="@+id/btnRestricted"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_restricted"/>
        <TextView
            android:textColor="#ffc62828"
            android:id="@+id/tvAutostart"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autostart_denied"
            android:paddingStart="26dp"/>
        <Button
            android:id="@+id/btnAutostart"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_autostart"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:id="@+id/dotStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:paddingEnd="8dp"/>
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step2"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvBleStatus"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ble_disconnected"
            android:paddingStart="26dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/tvPairHint"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_hint"
            android:paddingStart="26dp"/>
        <Button
            android:id="@+id/btnPair"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_pair"/>
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_connect"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:id="@+id/dotStep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:paddingEnd="8dp"/>
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step3"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvLastSent"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_sent_none"
            android:paddingStart="26dp"/>
        <Button
            android:enabled="false"
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test"/>
    </LinearLayout>
</ScrollView>
